
asset TwinRes_BaseLight {
    uint32_t unkData;
    float radius;
    Vector4 color;
    Vector4 position;
    Vector4 unkVec1;
    Vector4 unkVec2;
}

asset TwinRes_AmbientLight {
    TwinRes_BaseLight baseLight;
}

asset TwinRes_DirectionalLight {
    TwinRes_BaseLight baseLight;
    Vector4 direction;
    int16_t unkShort;
}

asset TwinRes_PointLight {
    TwinRes_BaseLight baseLight;
    int16_t unkShort;
}

asset TwinRes_NegativeLight {
    TwinRes_BaseLight baseLight;
    float unkFloat1;
    float unkFloat2;
    uint32_t unkUInt1;
    uint32_t unkUInt2;
    uint16_t unkUShort1;
    uint16_t unkUShort2;
}

asset TwinRes_SceneryLightsEnabledStorage {
    uint64_t low;
    uint64_t high;
}

asset TwinRes_SceneryNodeBase {
    int32_t hasMeshLods;
    [write_if("source->hasMeshLods == 0x1613")] int16_t meshesAmount;
    [write_if("source->hasMeshLods == 0x1613")] int16_t lodsAmount;
    [write_if("source->hasMeshLods == 0x1613")] [length(meshesAmount)] BoundingBox4* meshBoundingBoxes;
    [write_if("source->hasMeshLods == 0x1613")] [length(lodsAmount)] BoundingBox4* lodBoundingBoxes;

    [write_if("source->hasMeshLods == 0x1613")] [length(meshesAmount)] [link_resource("TS_RT_Mesh")]
    uint32_t* meshIds;

    [write_if("source->hasMeshLods == 0x1613")] [length(lodsAmount)] [link_resource("TS_RT_Lod")]
    uint32_t* lodIds;

    [write_if("source->hasMeshLods == 0x1613")] [length(meshesAmount)]
    Matrix* meshTransforms;

    [write_if("source->hasMeshLods == 0x1613")] [length(lodsAmount)]
    Matrix* lodTransforms;

    Vector4 unkVec1;
    Vector4 unkVec2;
    Vector4 unkVec3;
    Vector4 unkVec4;

    union lightsEnabledUnion {
        TwinRes_SceneryLightsEnabledStorage storage;
        struct lightsEnabledData {
            uint8_t light1Enabled : 1;
            uint8_t light2Enabled : 1;
            uint8_t light3Enabled : 1;
            uint8_t light4Enabled : 1;
