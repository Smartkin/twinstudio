asset TwinRes_SceneryLeaf {
    TwinRes_SceneryNodeBase baseNode;
}

asset TwinRes_SceneryNode {
    TwinRes_SceneryNodeBase baseNode;
    [length(8)] int32_t* sceneryNodeTypes;
    [write_if("source->sceneryNodeTypes[0] == 0x1600")] [length(1)] TwinRes_SceneryNode* node1;
    [write_if("source->sceneryNodeTypes[0] == 0x1605")] [length(1)] TwinRes_SceneryLeaf* leaf1;
    [write_if("source->sceneryNodeTypes[1] == 0x1600")] [length(1)] TwinRes_SceneryNode* node2;
    [write_if("source->sceneryNodeTypes[1] == 0x1605")] [length(1)] TwinRes_SceneryLeaf* leaf2;
    [write_if("source->sceneryNodeTypes[2] == 0x1600")] [length(1)] TwinRes_SceneryNode* node3;
    [write_if("source->sceneryNodeTypes[2] == 0x1605")] [length(1)] TwinRes_SceneryLeaf* leaf3;
    [write_if("source->sceneryNodeTypes[3] == 0x1600")] [length(1)] TwinRes_SceneryNode* node4;
    [write_if("source->sceneryNodeTypes[3] == 0x1605")] [length(1)] TwinRes_SceneryLeaf* leaf4;
    [write_if("source->sceneryNodeTypes[4] == 0x1600")] [length(1)] TwinRes_SceneryNode* node5;
    [write_if("source->sceneryNodeTypes[4] == 0x1605")] [length(1)] TwinRes_SceneryLeaf* leaf5;
    [write_if("source->sceneryNodeTypes[5] == 0x1600")] [length(1)] TwinRes_SceneryNode* node6;
    [write_if("source->sceneryNodeTypes[5] == 0x1605")] [length(1)] TwinRes_SceneryLeaf* leaf6;
    [write_if("source->sceneryNodeTypes[6] == 0x1600")] [length(1)] TwinRes_SceneryNode* node7;
    [write_if("source->sceneryNodeTypes[6] == 0x1605")] [length(1)] TwinRes_SceneryLeaf* leaf7;
    [write_if("source->sceneryNodeTypes[7] == 0x1600")] [length(1)] TwinRes_SceneryNode* node8;
    [write_if("source->sceneryNodeTypes[7] == 0x1605")] [length(1)] TwinRes_SceneryLeaf* leaf8;
}

asset TwinRes_RootScenery {
    uint32_t unkUInt;
    TwinRes_SceneryNode node;
}

asset TwinRes_Scenery {
    union flagsUnion {
        uint32_t flags;
        struct flagsData {
            uint16_t _pad;
            uint8_t hasSkydome : 1;
            uint8_t hasLighting : 1;
        };
    };

    TwinStudio_StringView name;
    uint32_t fogColorIndex;
    int32_t rootSceneryType;
    uint8_t unkByte;
    [write_if("source->hasSkydome")] [link_resource("TS_RT_Skydome")] uint32_t skydomeId;

    // Lighting stuff
    [write_if("source->hasLighting")] [void_read] [blob] [length(0x400)] void* lightAccessorBuffer;
    [write_if("source->hasLighting")] int32_t totalLights;
    [write_if("source->hasLighting")] int32_t ambientLightsAmount;
    [write_if("source->hasLighting")] int32_t dirLightsAmount;
    [write_if("source->hasLighting")] int32_t pointLightsAmount;
    [write_if("source->hasLighting")] int32_t negativeLightsAmount;
    [write_if("source->hasLighting")] [length(ambientLightsAmount)] TwinRes_AmbientLight* ambientLights;
    [write_if("source->hasLighting")] [length(dirLightsAmount)] TwinRes_DirectionalLight* directionalLights;
    [write_if("source->hasLighting")] [length(pointLightsAmount)] TwinRes_PointLight* pointLights;
    [write_if("source->hasLighting")] [length(negativeLightsAmount)] TwinRes_NegativeLight* negativeLights;

    [write_if("source->rootSceneryType == 0x160A")]
    TwinRes_RootScenery rootScenery;
}