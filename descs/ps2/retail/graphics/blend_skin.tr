#include "raylib.h"

[no_json] [no_read]
asset TwinRes_BlendSkinModelPartMorph {
    uint32_t faceVifDataLength;
    uint32_t vertexesAmount;
    [blob] [length("arrlen(source->vifData)")] void* vifData;
}

[no_json] [no_read]
asset TwinRes_BlendSkinModelPart {
    uint32_t vifDataLength;
    uint32_t vertexesAmount;
    [blob] [length(vifDataLength)] void* vifData;
    Vector3 blendShape;
    [no_length]
    TwinRes_BlendSkinModelPartMorph* morphs;
}

[no_json] [no_read]
asset TwinRes_BlendSkinModel {
    uint32_t partsAmount;
    [link_resource("Material")] uint32_t material;
    [length(partsAmount)] TwinRes_BlendSkinModelPart* modelParts;
}

[no_json] [no_read]
asset TwinRes_BlendSkin {
    uint32_t modelsAmount;
    uint32_t morphsAmount;
    [length(modelsAmount)] TwinRes_BlendSkinModel* models;
}
