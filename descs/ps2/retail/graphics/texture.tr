#include "texture_serialization.h"
#include "raylib.h"

[no_write] [no_bin]
asset TwinRes_TextureFormat {
    int32_t width;
    int32_t height;
    uint8_t mipLevels;
    int32_t clutBufferBasePointer;
    int32_t rrw;
    int32_t rrh;
    [length(6)] int32_t* mipLevelsTBP;
    [length(6)] int32_t* mipLevelsTBW;
}

[no_write] [no_bin]
asset TwinRes_TextureFormats {
    [length(15)] TwinRes_TextureFormat* formats;
}

[resource("TS_RT_Texture")]
asset TwinRes_Texture {
    [no_json] uint32_t textureDataLength;
    [no_json] uint32_t headerSignature = 0xbbcccdcd;
    [no_json] uint16_t imageWidthPower;
    [no_json] uint16_t imageHeightPower;
    [no_json] uint8_t  mipLevels;
    [no_json] uint8_t  textureFormat;
    [no_json] uint8_t  destinationTextureFormat;
    [no_json] uint8_t  colorComponent;
    [no_json] uint8_t  unkByte;
    uint8_t  textureFunction;
    [no_json] [length(2)] uint8_t* unkBytes1;
    [no_json] int32_t  textureBasePointer;
    [no_json] [length(6)] int32_t* mipLevelsTBP;
    [no_json] int32_t  textureBufferWidth;
    [no_json] [length(6)] int32_t* mipLevelsTBW;
    [no_json] int32_t  clutBufferBasePointer;
    [no_json] int32_t  clutBufferWidth;
    [no_json] [length(4)] uint8_t* unkBytes2;
    [no_json] int32_t _reserved1;
    [no_json] int32_t _reserved2;
    [no_json] [length(2)] uint8_t* unkBytes3;
    [no_json] [length(2)] uint8_t* _reserved3;
    [no_json] [length(32)] uint8_t* unusedMetadata;
    
    [resource("Image")] [length("source->textureDataLength - 128")]
    void* textureData;
}
