asset TwinRes_BehaviorStateBody {
    union bitfieldUnion {
        uint32_t bitfield;
        struct bitfieldData {
            uint8_t commandsAmount;
            bool    hasTraceEnabled : 1;
            bool    hasCondition : 1;
            bool    hasStateJump : 1;
        };
    };

    [write_if("source->hasStateJump")] int32_t state;
    [write_if("source->hasCondition")] TwinRes_BehaviorCondition condition;
    [length(commandsAmount)] TwinRes_BehaviorCommand* commands;
}

asset TwinRes_BehaviorState {
    union bitfieldUnion {
        uint16_t bitfield;
        struct bitfieldData {
            uint8_t bodiesAmount : 5;
            uint8_t unknown1  : 5;
            bool    unkFlag1  : 1;
            bool    isNonBlocking : 1;
            bool    callsObjectSlot : 1;
            bool    unkFlag2 : 1;
            bool    hasControlPacket : 1;
            bool    hasNext : 1;
        };
    };

    union [write_all] behaviourOrSlot {
        [write_if("source->callsObjectSlot")] uint16_t behaviorSlot;
        [write_if("!source->callsObjectSlot")] [link_resource("TS_RT_Behavior")] uint16_t behaviorGlobal;
    };

    [write_if("source->hasControlPacket")] TwinRes_BehaviorControlPacket controlPacket;
    [no_bin] [length(bodiesAmount)] TwinRes_BehaviorStateBody* bodies;
}

asset TwinRes_BehaviorGraph {
    TwinRes_BehaviorHeader header;
    TwinStudio_StringView name;
    [no_json] int32_t statesAmount;
    int32_t startState;
    [length(statesAmount)] TwinRes_BehaviorState* states;
}

asset TwinRes_BehaviorCommandPack {
    TwinRes_BehaviorCommand* commands;
}

asset TwinRes_BehaviorCommandSequence {
    uint16_t id;
    TwinRes_BehaviorCommandPack pack;
}

asset TwinRes_BehaviorCommandSequences {
    union headerUnion {
        uint32_t header;
        struct headerData {
            uint8_t instanceSubType;
            uint8_t indexInGlobalStorage;
            uint8_t sequencesAmount;
        };
    };

    [length(sequencesAmount)] TwinRes_BehaviorCommandSequence* sequences;
    [no_length("createdObj.hasNext")] TwinRes_BehaviorCommand* initCommands;
}