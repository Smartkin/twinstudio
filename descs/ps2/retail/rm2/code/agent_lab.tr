
asset TwinRes_BehaviorHeader {
    uint16_t id;
    uint8_t  priority;
    bool     isStarter;
}

asset TwinRes_BehaviorAssigner {
    int32_t behavior;
    union assignerUnion {
        uint32_t assigner;
        struct assignerData {
            uint8_t assignType : 4;
            uint8_t assignLocality : 4;
            uint8_t assignStatus : 4;
            uint16_t globalObjectId;
            uint8_t assignPreference : 4;
        };
    };
}

asset TwinRes_BehaviorStarter {
    TwinRes_BehaviorHeader header;
    TwinRes_BehaviorAssigner* assigners;
}

asset TwinRes_BehaviorControlPacketIntFloat {
    union intFloat {
        uint32_t intValue;
        float    floatValue;
    };
}

asset TwinRes_BehaviorControlPacket {
    [no_json] uint8_t bytesAmount;
    [no_json] uint8_t floatsAmount;
    [no_json] uint16_t version = 0x6;

    union packetSettingsUnion {
        uint32_t packetSettings;
        struct packetSettingsData {
            uint8_t space : 3;
            uint8_t motion : 4;
            uint8_t continuousRotate : 4;
            uint8_t accelerationFunction : 2;
            bool    translates : 1;
            bool    rotates : 1;
            bool    translationContinues : 1;
            bool    tracksDestination : 1;
            bool    interpolatesAngles : 1;
            bool    yawFaces : 1;
            bool    pitchFaces : 1;
            bool    orientsPredicts : 1;
            bool    isValid : 1;
            bool    keyIsLocal : 1;
            bool    usesRotator : 1;
            bool    usesInterpolator : 1;
            bool    usesPhysics : 1;
            bool    continuouslyRotatesInWorldSpace : 1;
            uint8_t axes : 3;
            bool    unkFlag : 1;
            bool    stalls : 1;
        };
    };

    [length(floatsAmount)] TwinRes_BehaviorControlPacketIntFloat* params;
    [length(bytesAmount)]  uint8_t* floatIndices;
}

asset TwinRes_BehaviorCondition {
    union bitfieldUnion {
        uint32_t bitfield;
        struct bitfieldData {
            uint16_t conditionIndex;
            bool     isNot : 1;
            uint16_t conditionParameter : 15;
        };
    };

    float checkInterval;
    float returnCheck;
    float conditionPowerMultiplier;
}

