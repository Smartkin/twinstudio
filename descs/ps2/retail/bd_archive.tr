#include "auto_struct_bh_archive.h"

[no_json]
asset TwinRes_BdRecord {
    [no_bin] TwinRes_BhRecord header;
    [blob] [length(header.length)] void* data;
}

[no_json] [no_read]
asset TwinRes_BdArchive {
    [no_bin]    TwinRes_BhArchive header;
    [no_bin]    uint32_t currentItemIterator = 0;
    [no_length] TwinRes_BdRecord* items;
}
